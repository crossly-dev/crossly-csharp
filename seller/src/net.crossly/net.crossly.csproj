<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo><!-- setting GenerateAssemblyInfo to false causes this bug https://github.com/dotnet/project-system/issues/3934 -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>net.crossly</AssemblyName>
    <PackageId>Crossly</PackageId>
    <OutputType>Library</OutputType>
    <Authors>Crossly</Authors>
    <Company>Crossly</Company>
    <AssemblyTitle>Crossly .NET SDK (seller)</AssemblyTitle>
    <Description>Official .NET client for the Crossly seller API (listings, crossposting, orders, analytics), generated from the public OpenAPI spec, with retries, idempotency keys and typed errors. Webhook verification: Crossly.Core; ASP.NET Core middleware: Crossly.AspNetCore.</Description>
    <Copyright>Copyright (c) Crossly</Copyright>
    <RootNamespace>net.crossly</RootNamespace>
    <Version>0.3.0</Version>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\net.crossly.xml</DocumentationFile>
    <RepositoryUrl>https://github.com/crossly-dev/crossly-csharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/crossly-dev/crossly-csharp/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <Product>Crossly .NET SDK</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/crossly-dev/crossly-csharp</PackageProjectUrl>
    <PackageTags>crossly;reselling;crosslisting;marketplace;sdk</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSubTypes" Version="1.8.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="RestSharp" Version="106.13.0" />
    <PackageReference Include="Polly" Version="7.2.2" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Webhook verifier, CrosslyException, CrosslyPages (one assembly for seller and buyer). -->
    <ProjectReference Include="../../../codegen/integrations/extras/csharp/Crossly.Core/Crossly.Core.csproj" />
  </ItemGroup>

</Project>
